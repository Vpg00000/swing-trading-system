import os
import sys
import json
import time
import psycopg2
from statistics import mean, median, stdev

# Set up test environment with virtual environment
def setup_environment():
    if not os.path.exists('venv'):
        os.system('python -m venv venv')
    os.system('source venv/bin/activate')

# Create test script to measure database latency
def create_test_script():
    with open('test_script.py', 'w') as f:
        f.write("""import psycopg2
import time

def measure_latency():
    conn = psycopg2.connect("dbname=test user=postgres")
    cur = conn.cursor()
    start_time = time.time()
    cur.execute("SELECT 1")
    end_time = time.time()
    conn.close()
    return end_time - start_time

if __name__ == "__main__":
    latencies = [measure_latency() for _ in range(100)]
    print(f"Mean latency: {mean(latencies)}")
    print(f"Median latency: {median(latencies)}")
    print(f"Standard deviation: {stdev(latencies)}")
""")

# Run multiple stress tests with a large number of queries
def run_stress_tests(num_queries):
    conn = psycopg2.connect("dbname=test user=postgres")
    cur = conn.cursor()
    for _ in range(num_queries):
        cur.execute("INSERT INTO test_table (value) VALUES (%s)", (os.urandom(10),))
    conn.commit()
    cur.close()
    conn.close()

# Collect and store latency data in JSON
def collect_latency_data(num_queries):
    os.system('python test_script.py > latency_data.json')

# Analyze data to determine mean, median, and standard deviation
def analyze_latency_data():
    with open('latency_data.json', 'r') as f:
        latencies = json.load(f)
    mean_latency = mean(latencies)
    median_latency = median(latencies)
    std_dev_latency = stdev(latencies)
    print(f"Mean latency: {mean_latency}")
    print(f"Median latency: {median_latency}")
    print(f"Standard deviation: {std_dev_latency}")

